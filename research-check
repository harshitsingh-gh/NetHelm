#!/usr/bin/env bash
# Research Agent wrapper — check code, paper text, or results against publication standards.
#
# Usage:
#   ./research-check --file harness/graders/safety.py
#   ./research-check --input "We evaluate 8 LLMs on 300 scenarios..."
#   ./research-check --mode results --file runs/2026-06-01_sweep/results.csv
#   ./research-check --mode paper --file paper/draft_section2.md
#   ./research-check --dry-run --file harness/graders/safety.py
#
# Modes: code (default), paper, results
# Requires ANTHROPIC_API_KEY env var.
set -euo pipefail
REPO="$(cd "$(dirname "$0")" && pwd)"
PYTHON="$REPO/harness/venvs/nethelm/bin/python"

if [[ ! -x "$PYTHON" ]]; then
  echo "ERROR: venv not found at $PYTHON" >&2
  echo "       Run: python -m venv harness/venvs/nethelm && harness/venvs/nethelm/bin/pip install -e '.[knowledge]' anthropic" >&2
  exit 1
fi

exec "$PYTHON" "$REPO/agents/research_agent.py" "$@"
